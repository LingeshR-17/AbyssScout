# AbyssScout Environment Configuration
# Copy this file to .env for local overrides. Never commit .env to git.

# Application
APP_NAME=AbyssScout
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Big Data Storage Paths (relative to project root or absolute)
DATA_RAW_DIR=data/raw
DATA_LAKE_DIR=data/lake
DUCKDB_PATH=data/abyssscout.duckdb

# Argo Telemetry Ingestion (ERDDAP / IFREMER)
# Set OFFLINE_MODE=true to skip remote network calls and use deterministic local NetCDF/synthetic data
OFFLINE_MODE=false
ARGO_ERDDAP_BASE_URL=https://erddap.ifremer.fr/erddap/tabledap
ARGO_FETCH_TIMEOUT_SECONDS=12
ARGO_MAX_FLOATS=45
ARGO_YEARS=2022,2023,2024,2025

# Anomaly Detection Thresholds
HEATWAVE_ANOMALY_THRESHOLD_C=1.5
MIN_DEPTH_M=0.0
MAX_DEPTH_M=2000.0
